# Server Configuration
PORT=5000

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/zycart?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_min_64_chars
JWT_EXPIRES_IN=7d

# OTP Settings
OTP_EXPIRY_MINUTES=5

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Platform Fees (0.20 = 20%)
PLATFORM_COMMISSION_RATE=0.20

# Allowed Frontend URLs for CORS
CLIENT_URL1=http://localhost:5173
CLIENT_URL2=http://localhost:5174
CLIENT_URL3=http://localhost:5175

# Email Credentials for Sending OTPs
EMAIL_USER=your-email@example.com
EMAIL_PASS=your_email_app_password
